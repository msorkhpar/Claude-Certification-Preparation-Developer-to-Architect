{
  "model": "opus",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Bash(git push *)",
      "Bash(curl *)"
    ]
  }
}
