      "typescript": "e4 no threshold exists when no confidence level meets the target",
      "java": "e4_noThresholdExistsWhenNoConfidenceLevelMeetsTheTarget",
      "kotlin": "e4_noThresholdExistsWhenNoConfidenceLevelMeetsTheTarget"
    },
    "e5": {
      "kind": "edge",
      "python": "test_e5_the_stratified_sample_takes_the_best_ranked_items_of_every_stratum",
      "typescript": "e5 the stratified sample takes the best ranked items of every stratum",
      "java": "e5_theStratifiedSampleTakesTheBestRankedItemsOfEveryStratum",
      "kotlin": "e5_theStratifiedSampleTakesTheBestRankedItemsOfEveryStratum"
    },
    "e6": {
      "kind": "edge",
