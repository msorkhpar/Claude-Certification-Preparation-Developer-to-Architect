      "typescript": "e6 low confidence and conflicts go to review with the weakest first",
      "java": "e6_lowConfidenceAndConflictsGoToReviewWithTheWeakestFirst",
      "kotlin": "e6_lowConfidenceAndConflictsGoToReviewWithTheWeakestFirst"
