      "java": "e3_theThresholdIsTheLowestConfidenceWhoseAcceptedItemsMeetTheTargetPrecision",
      "kotlin": "e3_theThresholdIsTheLowestConfidenceWhoseAcceptedItemsMeetTheTargetPrecision"
    },
    "e4": {
