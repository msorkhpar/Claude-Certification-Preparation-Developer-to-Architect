    "e7": {
      "kind": "edge",
      "python": "test_e7_review_capacity_is_respected_and_the_rest_wait_in_a_backlog",
      "typescript": "e7 review capacity is respected and the rest wait in a backlog",
      "java": "e7_reviewCapacityIsRespectedAndTheRestWaitInABacklog",
      "kotlin": "e7_reviewCapacityIsRespectedAndTheRestWaitInABacklog"
