    "e8": {
      "kind": "edge",
      "python": "test_e8_an_irreversible_action_needs_a_person_whatever_the_confidence",
      "typescript": "e8 an irreversible action needs a person whatever the confidence",
      "java": "e8_anIrreversibleActionNeedsAPersonWhateverTheConfidence",
      "kotlin": "e8_anIrreversibleActionNeedsAPersonWhateverTheConfidence"
