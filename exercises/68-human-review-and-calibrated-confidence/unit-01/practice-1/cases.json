  "plants": {
    "wrong-overall-only": {
      "caught_by": [
        "m1",
        "e1"
      ],
      "defect": "reports only the overall accuracy"
    },
    "wrong-ignores-undersampled": {
      "caught_by": [
        "e2"
      ],
      "defect": "approves automation for a segment with too few samples"
    },
    "wrong-highest-confidence": {
      "caught_by": [
        "e3"
      ],
      "defect": "picks the highest qualifying confidence instead of the lowest"
    },
    "wrong-strict-target": {
      "caught_by": [
        "e4"
      ],
      "defect": "demands more than the target precision"
    },
    "wrong-first-n-sample": {
      "caught_by": [
        "e5"
      ],
      "defect": "samples by identifier instead of by rank"
    },
    "wrong-conflict-auto": {
      "caught_by": [
        "e6"
      ],
      "defect": "lets a confident extraction with a conflict through"
    },
    "wrong-id-order": {
      "caught_by": [
        "e6"
      ],
      "defect": "orders the review queue by identifier instead of weakest first"
    },
    "wrong-ignores-capacity": {
      "caught_by": [
        "e7"
      ],
      "defect": "sends everything to review regardless of capacity"
    },
    "wrong-irreversible-by-amount": {
      "caught_by": [
        "e8"
      ],
      "defect": "checks only the amount for an irreversible action"
    }
  }
