{
  "mcpServers": {
    "docs": {
      "type": "stdio",
      "command": "python3",
      "args": ["tools/docs_server.py"]
    },
    "tickets": {
      "type": "http",
      "url": "${TICKETS_URL:-https://tickets.example.com/mcp}",
      "headers": {
        "Authorization": "Bearer ${TICKETS_TOKEN}"
      }
    }
  }
}
