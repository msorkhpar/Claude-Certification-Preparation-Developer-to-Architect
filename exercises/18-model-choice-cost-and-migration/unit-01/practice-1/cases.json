  "plants": {
    "wrong-flat-cache-read": {
      "caught_by": [
        "e1"
      ],
      "defect": "prices every cache read at a tenth of the input price, whatever the model"
    },
    "wrong-batch-output-only": {
      "caught_by": [
        "e2"
      ],
      "defect": "applies the batch discount to the output tokens only"
    },
    "wrong-first-eligible": {
      "caught_by": [
        "e3"
      ],
      "defect": "returns the first eligible model of the catalog instead of the cheapest"
    },
    "wrong-ignore-context": {
      "caught_by": [
        "e4"
      ],
      "defect": "never checks the context window or the output limit"
    },
    "wrong-tie-high-tier": {
      "caught_by": [
        "e6"
      ],
      "defect": "breaks a cost tie towards the higher tier"
    }
