{
  "name": "example-org-tools",
  "description": "Plugins for the platform team",
  "owner": { "name": "Example Org Platform Team", "email": "contact@example.com" },
  "allowCrossMarketplaceDependenciesOn": ["shared-tools"],
  "plugins": [
    {
      "name": "standards-kit",
      "source": "./plugins/standards-kit",
      "description": "Changelog skill, edit guard and ticket server for the platform team"
    },
    {
      "name": "lint-helper",
      "source": {
        "source": "github",
        "repo": "example-org/lint-helper",
        "ref": "v1.2.0",
        "sha": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0"
      },
      "description": "Runs the team's linters"
    },
    {
      "name": "db-tools",
      "source": {
        "source": "git-subdir",
        "url": "example-org/monorepo",
        "path": "tools/db-tools",
        "ref": "v2.0.0",
        "sha": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c"
      },
      "description": "Database helpers",
      "dependencies": [{ "name": "audit-logger", "marketplace": "shared-tools" }]
    }
  ],
  "renames": {
    "std-kit": "standards-kit",
    "old-linter": null
  }
}
