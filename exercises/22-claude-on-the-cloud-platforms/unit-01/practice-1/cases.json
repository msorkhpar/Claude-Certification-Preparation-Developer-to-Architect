  "plants": {
    "wrong-vertex-model-in-body": {
      "caught_by": [
        "e2"
      ],
      "defect": "leaves the model in the Vertex body"
    },
    "wrong-vertex-version-header": {
      "caught_by": [
        "m1",
        "e2"
      ],
      "defect": "sends the Vertex version as the anthropic-version header instead of a body field"
    },
    "wrong-bedrock-direct-id": {
      "caught_by": [
        "e1"
      ],
      "defect": "sends the direct API model id to Bedrock"
    },
    "wrong-regional-any": {
      "caught_by": [
        "e3"
      ],
      "defect": "allows any model on a specific Vertex region"
    },
    "wrong-batches-everywhere": {
      "caught_by": [
        "e5"
      ],
      "defect": "treats the Message Batches API as available on both clouds"
    },
    "wrong-body-mutated": {
      "caught_by": [
        "e2"
      ],
      "defect": "removes the model from the caller's own body"
    }
  }
}
