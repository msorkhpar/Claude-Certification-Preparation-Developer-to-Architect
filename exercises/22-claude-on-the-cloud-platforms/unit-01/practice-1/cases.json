      "java": "m1_theSameMessageTakesThreeShapes",
      "kotlin": "m1_theSameMessageTakesThreeShapes"
    },
    "e1": {
      "kind": "edge",
      "python": "test_e1_model_ids_change_with_the_platform",
      "typescript": "e1 model ids change with the platform",
      "java": "e1_modelIdsChangeWithThePlatform",
      "kotlin": "e1_modelIdsChangeWithThePlatform"
    },
    "e2": {
      "kind": "edge",
      "python": "test_e2_vertex_moves_the_model_into_the_url_and_the_version_into_the_body",
      "typescript": "e2 vertex moves the model into the url and the version into the body",
      "java": "e2_vertexMovesTheModelIntoTheUrlAndTheVersionIntoTheBody",
      "kotlin": "e2_vertexMovesTheModelIntoTheUrlAndTheVersionIntoTheBody"
    },
    "e3": {
      "kind": "edge",
      "python": "test_e3_vertex_endpoints_global_multi_region_and_regional",
      "typescript": "e3 vertex endpoints global multi region and regional",
      "java": "e3_vertexEndpointsGlobalMultiRegionAndRegional",
      "kotlin": "e3_vertexEndpointsGlobalMultiRegionAndRegional"
    },
    "e4": {
      "kind": "edge",
      "python": "test_e4_a_platform_serves_only_its_own_models",
      "typescript": "e4 a platform serves only its own models",
      "java": "e4_aPlatformServesOnlyItsOwnModels",
      "kotlin": "e4_aPlatformServesOnlyItsOwnModels"
    },
    "e5": {
      "kind": "edge",
      "python": "test_e5_each_platform_lacks_its_own_features",
      "typescript": "e5 each platform lacks its own features",
      "java": "e5_eachPlatformLacksItsOwnFeatures",
      "kotlin": "e5_eachPlatformLacksItsOwnFeatures"
    },
    "e6": {
      "kind": "edge",
      "python": "test_e6_a_request_needs_the_place_it_is_sent_to",
      "typescript": "e6 a request needs the place it is sent to",
      "java": "e6_aRequestNeedsThePlaceItIsSentTo",
      "kotlin": "e6_aRequestNeedsThePlaceItIsSentTo"
