  "plants": {
    "wrong-first-wins": {
      "caught_by": [
        "e2",
        "e3"
      ],
      "defect": "keeps only the first value of a claim and drops the others"
    },
    "wrong-ignores-dates": {
      "caught_by": [
        "e3",
        "e4"
      ],
      "defect": "calls every difference a conflict whatever the dates"
    },
    "wrong-sources-collapsed": {
      "caught_by": [
        "e4",
        "m1"
      ],
      "defect": "keeps only the first source of a value"
    },
    "wrong-date-optional": {
      "caught_by": [
        "e1"
      ],
      "defect": "does not require a date"
    },
    "wrong-accepts-incomplete": {
      "caught_by": [
        "e1"
      ],
      "defect": "merges a finding with a missing field"
    },
    "wrong-gaps-hidden": {
      "caught_by": [
        "e5"
      ],
      "defect": "leaves the planned claims with no finding out of the note"
    },
    "wrong-single-source-supported": {
      "caught_by": [
        "e4",
        "e5"
      ],
      "defect": "calls a claim with one source well supported"
    },
    "wrong-unknown-kind-accepted": {
      "caught_by": [
        "e8"
      ],
      "defect": "renders an unknown content type"
    },
    "wrong-no-table": {
      "caught_by": [
        "e6"
      ],
      "defect": "renders financial data as prose"
    },
    "wrong-conflict-unmarked": {
      "caught_by": [
        "e7"
      ],
      "defect": "leaves the disagreement out of the prose"
    },
    "wrong-conflict-keeps-one": {
      "caught_by": [
        "e2"
      ],
      "defect": "keeps only the first value of a conflict"
    },
    "wrong-changed-unordered": {
      "caught_by": [
        "e3"
      ],
      "defect": "leaves the values of a changed claim in the order they came"
    },
    "wrong-changed-also-contested": {
      "caught_by": [
        "e4"
      ],
      "defect": "files a changed claim under contested as well"
    }
  }
