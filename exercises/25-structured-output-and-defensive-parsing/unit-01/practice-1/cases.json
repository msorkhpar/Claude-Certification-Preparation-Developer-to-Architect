{
  "practice": "25-structured-output-and-defensive-parsing/unit-01/practice-1",
  "name": "extractor",
  "tests": {
    "java": "ExtractorTest",
    "kotlin": "ExtractorTest"
  },
  "cases": {
    "m1": {
      "kind": "main",
      "python": "test_m1_a_valid_reply_is_returned_after_one_call",
      "typescript": "m1 a valid reply is returned after one call",
      "java": "m1_aValidReplyIsReturnedAfterOneCall",
      "kotlin": "m1_aValidReplyIsReturnedAfterOneCall"
    },
    "e1": {
      "kind": "edge",
      "python": "test_e1_json_is_found_in_fences_and_prose_and_bad_text_is_retried",
      "typescript": "e1 json is found in fences and prose and bad text is retried",
      "java": "e1_jsonIsFoundInFencesAndProseAndBadTextIsRetried",
      "kotlin": "e1_jsonIsFoundInFencesAndProseAndBadTextIsRetried"
    },
    "e2": {
      "kind": "edge",
      "python": "test_e2_every_schema_violation_is_listed_and_sent_back_to_the_model",
      "typescript": "e2 every schema violation is listed and sent back to the model",
      "java": "e2_everySchemaViolationIsListedAndSentBackToTheModel",
      "kotlin": "e2_everySchemaViolationIsListedAndSentBackToTheModel"
    },
    "e3": {
      "kind": "edge",
      "python": "test_e3_the_number_of_attempts_is_bounded",
      "typescript": "e3 the number of attempts is bounded",
      "java": "e3_theNumberOfAttemptsIsBounded",
      "kotlin": "e3_theNumberOfAttemptsIsBounded"
    },
    "e4": {
      "kind": "edge",
      "python": "test_e4_a_refusal_or_a_cut_off_reply_is_not_retried",
      "typescript": "e4 a refusal or a cut off reply is not retried",
      "java": "e4_aRefusalOrACutOffReplyIsNotRetried",
      "kotlin": "e4_aRefusalOrACutOffReplyIsNotRetried"
    },
    "e5": {
      "kind": "edge",
      "python": "test_e5_a_quote_that_is_not_in_the_document_is_rejected",
      "typescript": "e5 a quote that is not in the document is rejected",
      "java": "e5_aQuoteThatIsNotInTheDocumentIsRejected",
      "kotlin": "e5_aQuoteThatIsNotInTheDocumentIsRejected"
    },
    "e6": {
      "kind": "edge",
      "python": "test_e6_types_are_exact_booleans_are_not_numbers_and_integers_have_no_fraction",
      "typescript": "e6 types are exact booleans are not numbers and integers have no fraction",
      "java": "e6_typesAreExactBooleansAreNotNumbersAndIntegersHaveNoFraction",
      "kotlin": "e6_typesAreExactBooleansAreNotNumbersAndIntegersHaveNoFraction"
    }
  },
  "plants": {
    "wrong-no-prose-skip": {
      "caught_by": [
        "e1"
      ],
      "defect": "reads the whole reply as JSON and fails on prose around the object"
    },
    "wrong-generic-retry": {
      "caught_by": [
        "e2"
      ],
      "defect": "re-prompts without telling the model which fields were wrong"
    },
    "wrong-extra-attempt": {
      "caught_by": [
        "e3"
      ],
      "defect": "makes one call more than the attempt limit"
    },
    "wrong-retry-refusal": {
      "caught_by": [
        "e4"
      ],
      "defect": "treats a refusal as a bad reply and asks again"
    },
    "wrong-no-grounding": {
      "caught_by": [
        "e5"
      ],
      "defect": "accepts a quote that the document does not contain"
    },
    "wrong-integer-allows-fraction": {
      "caught_by": [
        "e6"
      ],
      "defect": "accepts 2.5 as an integer"
    }
  }
}
